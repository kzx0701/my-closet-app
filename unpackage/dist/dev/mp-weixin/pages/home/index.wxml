<view class="page"><view class="page-bg"></view><view class="hero-zone"><view class="topbar"><view class="greeting"><text class="greeting-hi">{{a}}</text><text class="greeting-name">{{b}}</text></view><view class="logout-btn" bindtap="{{c}}"><view class="logout-icon"></view></view></view><view class="scope-info"><view class="scope-badge"><view class="scope-badge-dot"></view><text class="scope-badge-text">{{d}}</text></view><text class="scope-title">{{e}}<text class="scope-title-em">{{f}}</text></text><text class="scope-desc">{{g}}</text><view class="scope-meta-inline"><view wx:for="{{h}}" wx:for-item="item" wx:key="d" class="scope-meta-item"><text class="scope-meta-key">{{item.a}}</text><text class="{{['scope-meta-val', item.c && 'accent']}}">{{item.b}}</text></view></view></view></view><view class="stats-zone"><text class="stats-label">Overview · 概览</text><view class="stats-row"><view class="stat-item"><text class="stat-value">{{i}}</text><text class="stat-label">衣橱</text></view><view class="stat-item"><text class="stat-value accent">{{j}}</text><text class="stat-label">衣物</text></view><view class="stat-item"><text class="stat-value">{{k}}</text><text class="stat-label">未归类</text></view></view></view><view class="actions-zone"><view class="action-card dark" bindtap="{{n}}"><view class="card-top"><view class="card-number-wrap"><text class="card-number">{{l}}</text><text class="card-number-unit">个</text></view></view><view class="card-bottom"><text class="card-title">{{m}}</text><text class="card-subtitle">查看和管理</text></view><view class="card-arrow"></view></view><view class="action-card light" bindtap="{{q}}"><view class="card-top"><view class="card-number-wrap"><text class="card-number">{{o}}</text><text class="card-number-unit">件</text></view></view><view class="card-bottom"><text class="card-title">{{p}}</text><text class="card-subtitle">浏览列表</text></view><view class="card-arrow"></view></view></view><view class="family-zone"><text class="family-label">Family · 家庭协作</text><view wx:if="{{r}}" class="family-invite-box"><view class="family-name-row"><text class="family-name">{{s}}</text><text class="family-role">{{t}}</text></view><view class="invite-row"><text class="invite-label">邀请码</text><text class="invite-code">{{v}}</text><view class="copy-btn" bindtap="{{w}}"><view class="copy-icon"></view></view></view><view class="members-row"><view class="member-avatar admin">我</view><text class="member-more">共 {{x}} 人</text></view></view><view wx:else class="family-empty-box"><text class="family-empty-title">开启<text class="family-empty-em">家庭</text>协作</text><text class="family-empty-desc">加入后可和家人共享衣橱与衣物，按角色协作管理。</text><view class="family-empty-actions"><button class="btn-primary" bindtap="{{y}}">创建家庭</button><button class="btn-secondary" bindtap="{{z}}">加入家庭</button></view></view></view><view class="season-tip"><text class="season-tip-label">{{A}}</text><text class="season-tip-text">{{B}}</text></view><h5-tab-bar wx:if="{{C}}" u-i="7ebccf70-0" bind:__l="__l" u-p="{{C}}"/></view>