<view class="page"><view class="page-head"><view><text class="page-eyebrow">HOME</text><text class="page-title">衣橱首页</text></view><button class="logout-btn" bindtap="{{a}}">退出登录</button></view><scope-status-card wx:if="{{b}}" u-i="7ebccf70-0" bind:__l="__l" u-p="{{b}}"/><view class="section"><view class="section-head"><text class="section-title">快捷操作</text><text class="section-subtitle">先从最常用的动作开始</text></view><home-quick-actions wx:if="{{d}}" bindselect="{{c}}" u-i="7ebccf70-1" bind:__l="__l" u-p="{{d}}"/></view><view class="section"><view class="section-head"><text class="section-title">当前空间摘要</text><text class="section-subtitle">衣橱与衣物摘要已接入真实数据</text></view><view class="stats-grid"><view wx:for="{{e}}" wx:for-item="item" wx:key="d" class="stat-card"><text class="stat-value">{{item.a}}</text><text class="stat-label">{{item.b}}</text><text class="stat-desc">{{item.c}}</text></view></view></view><view class="section"><view class="section-head"><text class="section-title">{{f}}</text><text class="section-subtitle">围绕家庭协作的当前入口</text></view><view class="panel-card"><text class="panel-desc">{{g}}</text><view class="panel-actions"><button wx:for="{{h}}" wx:for-item="item" wx:key="b" class="panel-btn" bindtap="{{item.c}}">{{item.a}}</button></view></view></view><view class="section"><view class="section-head"><text class="section-title">提示事项</text><text class="section-subtitle">给你一个自然的下一步</text></view><view class="tips-list"><view wx:for="{{i}}" wx:for-item="item" wx:key="c" class="tip-card"><view class="tip-dot"></view><view class="tip-body"><text class="tip-title">{{item.a}}</text><text class="tip-desc">{{item.b}}</text></view></view></view></view><h5-tab-bar wx:if="{{j}}" u-i="7ebccf70-2" bind:__l="__l" u-p="{{j}}"/></view>