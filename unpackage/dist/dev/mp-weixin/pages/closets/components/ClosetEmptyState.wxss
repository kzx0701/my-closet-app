/* 顶部插画 */
.empty-state__art.data-v-3720155d {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}
.empty-state__art-circle.data-v-3720155d {
  position: relative;
  z-index: 2;
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #3a5443 0%, #4a6755 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 40rpx rgba(58, 84, 67, 0.22);
}
.empty-state__art-circle svg.data-v-3720155d {
  width: 72rpx;
  height: 72rpx;
  color: #ffffff;
}
.empty-state__art-orbit.data-v-3720155d {
  position: absolute;
  z-index: 1;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 50%;
  border: 2rpx dashed rgba(58, 84, 67, 0.14);
  animation: slowSpin-3720155d 18s linear infinite;
}
.empty-state__art-orbit.data-v-3720155d::before, .empty-state__art-orbit.data-v-3720155d::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  border: 2rpx dashed rgba(58, 84, 67, 0.1);
}
.empty-state__art-orbit.data-v-3720155d::before {
  inset: 20rpx;
}
.empty-state__art-orbit.data-v-3720155d::after {
  inset: 40rpx;
  border-color: rgba(196, 92, 62, 0.12);
}
@keyframes slowSpin-3720155d {
from {
    transform: rotate(0deg);
}
to {
    transform: rotate(360deg);
}
}
