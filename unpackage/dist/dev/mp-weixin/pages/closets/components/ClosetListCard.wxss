.closet-card.data-v-35651610 {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 36rpx;
  background: #f8f4ec;
  border: 1px solid rgba(58, 84, 67, 0.1);
  transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
}
.closet-card.data-v-35651610:hover,
.closet-card.data-v-35651610:active {
  transform: translateY(-3px);
  box-shadow: 0 16rpx 36rpx rgba(73, 81, 69, 0.08);
}
.closet-card-hover.data-v-35651610 {
  transform: translateY(-2px);
  box-shadow: 0 16rpx 36rpx rgba(73, 81, 69, 0.08);
  opacity: 0.92;
}

/* 缩略图区 */
.closet-thumb.data-v-35651610 {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.thumb-style-modern-flat.data-v-35651610 {
  background: #e8dcc4;
}
.thumb-style-arched-vintage.data-v-35651610 {
  background: #d4c4b0;
}
.thumb-style-open-rack.data-v-35651610 {
  background: #dfe8d8;
}
.thumb-style-drawer-mix.data-v-35651610 {
  background: #e0d6c0;
}
.thumb-icon.data-v-35651610 {
  width: 36rpx;
  height: 36rpx;
  stroke: #2d4334;
  opacity: 0.5;
}

/* 信息区 */
.closet-info.data-v-35651610 {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.closet-name.data-v-35651610 {
  font-family: "Fraunces", "Songti SC", "STSong", "Georgia", "PingFang SC", serif;
  font-size: 34rpx;
  font-weight: 600;
  color: #2a2a24;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.closet-meta.data-v-35651610 {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.meta-style.data-v-35651610,
.meta-color.data-v-35651610 {
  font-family: "Manrope", "PingFang SC", "PingFangSC", "Microsoft YaHei", -apple-system, sans-serif;
  font-size: 22rpx;
  color: #8a8a7e;
}
.meta-dot.data-v-35651610 {
  font-size: 22rpx;
  color: #8a8a7e;
  opacity: 0.5;
}
.closet-room-tag.data-v-35651610 {
  display: inline-flex;
  align-items: center;
  margin-top: 4rpx;
}
.room-tag-text.data-v-35651610 {
  font-family: "JetBrains Mono", "SF Mono", "Consolas", "Menlo", monospace;
  font-size: 18rpx;
  letter-spacing: 1rpx;
  text-transform: uppercase;
  color: #4a4a42;
  background: #ebe4d6;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

/* 计数区 */
.closet-count-wrap.data-v-35651610 {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2rpx;
  flex-shrink: 0;
}
.closet-count.data-v-35651610 {
  font-family: "Fraunces", "Songti SC", "STSong", "Georgia", "PingFang SC", serif;
  font-size: 44rpx;
  font-weight: 400;
  line-height: 1;
  color: #2d4334;
  letter-spacing: -1rpx;
}
.closet-count-unit.data-v-35651610 {
  font-family: "Manrope", "PingFang SC", "PingFangSC", "Microsoft YaHei", -apple-system, sans-serif;
  font-size: 18rpx;
  color: #8a8a7e;
}