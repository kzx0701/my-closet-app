.design-c.data-v-8bcdfb1b {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #2d4334;
}

/* 背景 - 145度渐变 */
.c-bg.data-v-8bcdfb1b {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  background: linear-gradient(145deg, #2d4334 0%, #3a5443 35%, #4a6755 60%, #7a9580 85%, #a8bcae 100%);
}
.c-bg-noise.data-v-8bcdfb1b {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  opacity: 0.04;
  pointer-events: none;
}
.c-deco.data-v-8bcdfb1b {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  pointer-events: none;
}
.c-deco-svg.data-v-8bcdfb1b {
  width: 100%;
  height: 100%;
}

/* 返回按钮 */
.c-back.data-v-8bcdfb1b {
  position: absolute;
  left: 28rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(244, 239, 230, 0.1);
  border: 1px solid rgba(244, 239, 230, 0.15);
  color: #f8f4ec;
  z-index: 10;
  transition: all 0.25s ease;
}
.c-back.data-v-8bcdfb1b:active {
  background: rgba(244, 239, 230, 0.2);
  transform: scale(0.95);
}
.c-back-icon.data-v-8bcdfb1b {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.85;
}

/* 顶部品牌标识 */
.c-top-brand.data-v-8bcdfb1b {
  position: relative;
  z-index: 2;
  padding-left: 56rpx;
  padding-right: 56rpx;
  animation: fadeUp 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) 0.1s both;
}
.c-brand-mark.data-v-8bcdfb1b {
  display: flex;
  align-items: center;
  gap: 8px;
}
.c-brand-dot.data-v-8bcdfb1b {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #d4805f;
  animation: pulseDot 2.5s ease-in-out infinite;
}
.c-brand-mark-text.data-v-8bcdfb1b {
  font-family: "JetBrains Mono", "SF Mono", "Consolas", "Menlo", monospace;
  font-size: 20rpx;
  letter-spacing: 3px;
  color: rgba(244, 239, 230, 0.55);
  font-weight: 500;
}

/* 中心卡片 */
.c-card-wrap.data-v-8bcdfb1b {
  flex: 1;
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 48rpx;
}
.c-card.data-v-8bcdfb1b {
  width: 100%;
  background: rgba(255, 255, 255, 0.94);
  -webkit-backdrop-filter: blur(20px);
          backdrop-filter: blur(20px);
  border-radius: 36rpx;
  padding: 56rpx 44rpx 48rpx;
  box-shadow: 0 16px 48px rgba(0, 0, 0, 0.15);
  animation: fadeUp 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) 0.2s both;
}

/* 卡片内品牌区 */
.c-brand-area.data-v-8bcdfb1b {
  text-align: center;
  margin-bottom: 44rpx;
}
.c-title-en.data-v-8bcdfb1b {
  display: block;
  font-family: "Fraunces", "Songti SC", "STSong", "Georgia", "PingFang SC", serif;
  font-size: 44rpx;
  font-weight: 300;
  line-height: 1;
  letter-spacing: -1rpx;
  color: #2d4334;
  margin-bottom: 8rpx;
}
.c-title-cn-row.data-v-8bcdfb1b {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 4rpx;
  margin-bottom: 20rpx;
}
.c-title-cn.data-v-8bcdfb1b {
  font-family: "Fraunces", "Songti SC", "STSong", "Georgia", "PingFang SC", serif;
  font-size: 24rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  color: #8a8a7e;
}
.c-title-cn.em.data-v-8bcdfb1b {
  transform: skewX(-8deg);
  transform-origin: left center;
  font-weight: 300;
  color: #7a9580;
}
.c-welcome.data-v-8bcdfb1b {
  display: block;
  font-family: "Manrope", "PingFang SC", "PingFangSC", "Microsoft YaHei", -apple-system, sans-serif;
  font-size: 28rpx;
  font-weight: 600;
  color: #2d4334;
  letter-spacing: 1rpx;
}

/* 微信登录区 */
.c-wx-area.data-v-8bcdfb1b {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.c-wx-btn.data-v-8bcdfb1b {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 40rpx;
  background: rgba(7, 193, 96, 0.9);
  color: #f8f4ec;
  border: none;
  font-family: "Manrope", "PingFang SC", "PingFangSC", "Microsoft YaHei", -apple-system, sans-serif;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 8px 24px rgba(7, 193, 96, 0.2);
  transition: all 0.2s ease;
}
.c-wx-btn.data-v-8bcdfb1b:active {
  transform: scale(0.98);
  opacity: 0.9;
}
.c-wx-btn.data-v-8bcdfb1b::after {
  border: none;
}
.c-wx-btn[disabled].data-v-8bcdfb1b {
  opacity: 0.5;
}
.c-wx-icon.data-v-8bcdfb1b {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

/* 分割线 */
.c-divider-row.data-v-8bcdfb1b {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 36rpx 0 24rpx;
  width: 100%;
}
.c-divider-line.data-v-8bcdfb1b {
  flex: 1;
  height: 1px;
  background: rgba(58, 84, 67, 0.1);
}
.c-divider-text.data-v-8bcdfb1b {
  font-family: "Manrope", "PingFang SC", "PingFangSC", "Microsoft YaHei", -apple-system, sans-serif;
  font-size: 22rpx;
  color: #c0c0c0;
  font-weight: 400;
}
.c-switch-text.data-v-8bcdfb1b {
  font-family: "Manrope", "PingFang SC", "PingFangSC", "Microsoft YaHei", -apple-system, sans-serif;
  font-size: 26rpx;
  font-weight: 500;
  color: #b85c3a;
  transition: opacity 0.2s ease;
}
.c-switch-text.data-v-8bcdfb1b:active {
  opacity: 0.7;
}

/* 账号密码表单 */
.c-form-area.data-v-8bcdfb1b {
  display: flex;
  flex-direction: column;
}
.c-field.data-v-8bcdfb1b {
  margin-bottom: 28rpx;
  border-bottom: 1px solid rgba(58, 84, 67, 0.1);
  transition: border-color 0.3s ease;
}
.c-field.focused.data-v-8bcdfb1b {
  border-bottom-color: #b85c3a;
}
.c-field-label.data-v-8bcdfb1b {
  display: block;
  font-family: "JetBrains Mono", "SF Mono", "Consolas", "Menlo", monospace;
  font-size: 20rpx;
  letter-spacing: 2px;
  color: #8a8a7e;
  margin-bottom: 8rpx;
  text-transform: uppercase;
}
.c-input.data-v-8bcdfb1b {
  width: 100%;
  height: 80rpx;
  font-family: "Manrope", "PingFang SC", "PingFangSC", "Microsoft YaHei", -apple-system, sans-serif;
  font-size: 30rpx;
  font-weight: 500;
  color: #2a2a24;
  background: transparent;
  border: none;
}
.c-form-links.data-v-8bcdfb1b {
  display: flex;
  justify-content: space-between;
  margin-bottom: 36rpx;
}
.c-link-btn.data-v-8bcdfb1b {
  font-family: "Manrope", "PingFang SC", "PingFangSC", "Microsoft YaHei", -apple-system, sans-serif;
  font-size: 24rpx;
  font-weight: 500;
  color: #b85c3a;
  transition: opacity 0.2s ease;
}
.c-link-btn.data-v-8bcdfb1b:active {
  opacity: 0.7;
}
.c-login-btn.data-v-8bcdfb1b {
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 40rpx;
  background: #2d4334;
  color: #f8f4ec;
  border: none;
  font-family: "Manrope", "PingFang SC", "PingFangSC", "Microsoft YaHei", -apple-system, sans-serif;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  box-shadow: 0 8px 24px rgba(45, 67, 52, 0.2);
  transition: all 0.2s ease;
}
.c-login-btn.data-v-8bcdfb1b:active {
  transform: scale(0.98);
  opacity: 0.9;
}
.c-login-btn.data-v-8bcdfb1b::after {
  border: none;
}
.c-login-btn[disabled].data-v-8bcdfb1b {
  opacity: 0.5;
}

/* 底部协议 */
.c-footer.data-v-8bcdfb1b {
  position: relative;
  z-index: 2;
  padding: 0 56rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  animation: fadeUp 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) 0.4s both;
}
.c-agreement.data-v-8bcdfb1b {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}
.c-agreement.shake.data-v-8bcdfb1b {
  animation: shake-8bcdfb1b 0.4s ease;
}
@keyframes shake-8bcdfb1b {
0%, 100% {
    transform: translateX(0);
}
20% {
    transform: translateX(-8rpx);
}
40% {
    transform: translateX(8rpx);
}
60% {
    transform: translateX(-6rpx);
}
80% {
    transform: translateX(6rpx);
}
}
.c-check.data-v-8bcdfb1b {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2px solid rgba(244, 239, 230, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2rpx;
  transition: all 0.2s ease;
}
.c-check.checked.data-v-8bcdfb1b {
  background: #d4805f;
  border-color: #d4805f;
}
.c-check-icon.data-v-8bcdfb1b {
  width: 20rpx;
  height: 20rpx;
  color: #f8f4ec;
}
.c-agreement-text.data-v-8bcdfb1b {
  font-family: "Manrope", "PingFang SC", "PingFangSC", "Microsoft YaHei", -apple-system, sans-serif;
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(244, 239, 230, 0.55);
}
.c-link.data-v-8bcdfb1b {
  color: #d4805f;
}