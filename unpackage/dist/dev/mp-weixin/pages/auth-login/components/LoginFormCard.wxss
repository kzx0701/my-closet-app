.card {
  padding: 38rpx 30rpx 34rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 22rpx 54rpx rgba(35, 43, 34, 0.12);
}
.field + .field {
  margin-top: 26rpx;
}
.label {
  display: block;
  margin-bottom: 14rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #2a2a24;
}
.links {
  display: flex;
  justify-content: center;
  margin-top: 28rpx;
}
.link {
  font-size: 24rpx;
  color: #4a4a42;
}