.basic-form.data-v-1caf9a53 {
  margin-top: 48rpx;
}
.section.data-v-1caf9a53 {
  margin-top: 48rpx;
}
.basic-form .section.data-v-1caf9a53:first-child {
  margin-top: 0;
}
.section-title.data-v-1caf9a53 {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
  font-family: "JetBrains Mono", "SF Mono", "Consolas", "Menlo", monospace;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #8a8a7e;
}
.hint.data-v-1caf9a53 {
  font-family: "Manrope", "PingFang SC", "PingFangSC", "Microsoft YaHei", -apple-system, sans-serif;
  font-size: 22rpx;
  letter-spacing: 0;
  text-transform: none;
  color: #8a8a7e;
}
.form-input.data-v-1caf9a53 {
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 40rpx;
  background: rgba(58, 84, 67, 0.04);
  border: 1px solid rgba(58, 84, 67, 0.05);
  font-family: "Manrope", "PingFang SC", "PingFangSC", "Microsoft YaHei", -apple-system, sans-serif;
  font-size: 28rpx;
  color: #2a2a24;
  box-sizing: border-box;
  transition: border-color 0.2s ease;
}
.form-input-focus.data-v-1caf9a53 {
  border-color: #3a5443;
}
.form-input-placeholder.data-v-1caf9a53 {
  color: #8a8a7e;
  font-size: 26rpx;
}
.chip-row.data-v-1caf9a53 {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.chip.data-v-1caf9a53 {
  padding: 14rpx 28rpx;
  border-radius: 40rpx;
  background: #ebe4d6;
  border: 1px solid transparent;
  transition: all 0.25s ease;
}
.chip.active.data-v-1caf9a53 {
  background: #3a5443;
  border-color: #3a5443;
}
.chip-text.data-v-1caf9a53 {
  font-family: "Manrope", "PingFang SC", "PingFangSC", "Microsoft YaHei", -apple-system, sans-serif;
  font-size: 24rpx;
  color: #4a4a42;
}
.chip.active .chip-text.data-v-1caf9a53 {
  color: #f8f4ec;
  font-weight: 600;
}

/* 颜色选择器 */
.color-scroll.data-v-1caf9a53 {
  width: 100%;
  white-space: nowrap;
}
.color-chip-row.data-v-1caf9a53 {
  display: inline-flex;
  align-items: center;
  gap: 24rpx;
  padding: 4rpx 0;
}
.color-chip.data-v-1caf9a53 {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx;
  border-radius: 40rpx;
  border: 2rpx solid transparent;
  transition: all 0.25s ease;
}
.color-chip.active.data-v-1caf9a53 {
  border-color: #3a5443;
  background: rgba(58, 84, 67, 0.06);
}
.color-dot.data-v-1caf9a53 {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 1px solid rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
}

/* 花色：使用渐变背景 */
.color-dot-multicolor.data-v-1caf9a53 {
  border: 1px solid rgba(0, 0, 0, 0.12);
}
.color-label.data-v-1caf9a53 {
  font-family: "Manrope", "PingFang SC", "PingFangSC", "Microsoft YaHei", -apple-system, sans-serif;
  font-size: 22rpx;
  color: #4a4a42;
}
.color-chip.active .color-label.data-v-1caf9a53 {
  color: #2a2a24;
  font-weight: 600;
}