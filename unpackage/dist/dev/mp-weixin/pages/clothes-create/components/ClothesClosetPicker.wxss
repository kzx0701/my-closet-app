.picker-card {
  margin-top: 24rpx;
  padding: 30rpx 26rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f8f4ec 100%);
  box-shadow: 0 16rpx 36rpx rgba(73, 81, 69, 0.08);
  border: 2rpx solid rgba(107, 126, 99, 0.08);
}
.label {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #2a2a24;
}
.desc {
  display: block;
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #4a4a42;
}