.page.data-v-8dea95b8 {
  position: relative;
  min-height: 100vh;
  padding-top: 96px;
  background: #f4efe6;
  overflow: hidden;
}
.page-bg.data-v-8dea95b8 {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  min-height: 100%;
  z-index: 0;
  background: linear-gradient(180deg, #2d4334 0%, #3a5443 12%, #4a6755 20%, #7a9580 28%, #a8bcae 34%, #c8cebf 38%, #f4efe6 42%, #f4efe6 100%);
}

/* 导航栏 */
.navbar.data-v-8dea95b8 {
  position: absolute;
  top: 56px;
  left: 0;
  right: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28px;
  height: 32px;
}
.nav-back.data-v-8dea95b8 {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.15);
  color: #f8f4ec;
  transition: all 0.25s ease;
}
.nav-back.data-v-8dea95b8:hover,
.nav-back.data-v-8dea95b8:active {
  background: rgba(255, 255, 255, 0.2);
}
.nav-back-icon.data-v-8dea95b8 {
  width: 18px;
  height: 18px;
}
.nav-title.data-v-8dea95b8 {
  font-family: "Manrope", "PingFang SC", "PingFangSC", "Microsoft YaHei", -apple-system, sans-serif;
  font-size: 14px;
  font-weight: 600;
  color: #f8f4ec;
}
.nav-placeholder.data-v-8dea95b8 {
  width: 32px;
}

/* Hero 区 */
.hero.data-v-8dea95b8 {
  position: relative;
  z-index: 2;
  padding: 0 28px 24px;
  color: #f8f4ec;
}
.hero-title.data-v-8dea95b8 {
  display: block;
  margin-top: 18rpx;
  margin-bottom: 20rpx;
  font-family: "Fraunces", "Songti SC", "STSong", "Georgia", "PingFang SC", serif;
  font-size: 56rpx;
  font-weight: 400;
  line-height: 1.1;
  letter-spacing: -1rpx;
  color: #f8f4ec;
}
.hero-desc.data-v-8dea95b8 {
  display: block;
  font-family: "Manrope", "PingFang SC", "PingFangSC", "Microsoft YaHei", -apple-system, sans-serif;
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(244, 239, 230, 0.5);
  max-width: 560rpx;
}

/* 表单区 */
.form-body.data-v-8dea95b8 {
  position: relative;
  z-index: 2;
  padding: 24px 28px 130px;
}

/* 底部固定栏 */
.bottom-bar.data-v-8dea95b8 {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16px 28px 36px;
  background: linear-gradient(180deg, rgba(244, 239, 230, 0) 0%, #f4efe6 30%);
  z-index: 30;
}
.submit-btn.data-v-8dea95b8 {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 40rpx;
  background: #3a5443;
  color: #f8f4ec;
  border: none;
  font-family: "Manrope", "PingFang SC", "PingFangSC", "Microsoft YaHei", -apple-system, sans-serif;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}
.submit-btn.data-v-8dea95b8:active {
  transform: scale(0.98);
  opacity: 0.9;
}
.submit-btn.data-v-8dea95b8::after {
  border: none;
}

/* 成功态 */
.success-wrap.data-v-8dea95b8 {
  position: relative;
  z-index: 2;
  padding: 24px 28px 60px;
}
.success-card.data-v-8dea95b8 {
  background: #f8f4ec;
  border: 1px solid rgba(58, 84, 67, 0.1);
  border-radius: 36rpx;
  padding: 44rpx;
}
.success-label.data-v-8dea95b8 {
  display: block;
  font-family: "JetBrains Mono", "SF Mono", "Consolas", "Menlo", monospace;
  font-size: 18rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #b85c3a;
  margin-bottom: 16rpx;
}
.success-name.data-v-8dea95b8 {
  display: block;
  font-family: "Fraunces", "Songti SC", "STSong", "Georgia", "PingFang SC", serif;
  font-size: 40rpx;
  font-weight: 600;
  color: #2d4334;
  margin-bottom: 28rpx;
  letter-spacing: -0.6rpx;
}
.success-row.data-v-8dea95b8 {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 20rpx 0;
  border-top: 1px solid rgba(58, 84, 67, 0.05);
}
.success-key.data-v-8dea95b8 {
  font-family: "JetBrains Mono", "SF Mono", "Consolas", "Menlo", monospace;
  font-size: 18rpx;
  letter-spacing: 3rpx;
  text-transform: uppercase;
  color: #8a8a7e;
}
.success-val.data-v-8dea95b8 {
  font-family: "Fraunces", "Songti SC", "STSong", "Georgia", "PingFang SC", serif;
  font-size: 28rpx;
  font-weight: 500;
  color: #2d4334;
}
.success-val.code.data-v-8dea95b8 {
  font-family: "JetBrains Mono", "SF Mono", "Consolas", "Menlo", monospace;
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: #b85c3a;
}
.success-actions.data-v-8dea95b8 {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 36rpx;
}
.primary-action.data-v-8dea95b8,
.secondary-action.data-v-8dea95b8 {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 40rpx;
  font-family: "Manrope", "PingFang SC", "PingFangSC", "Microsoft YaHei", -apple-system, sans-serif;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}
.primary-action.data-v-8dea95b8::after,
.secondary-action.data-v-8dea95b8::after {
  border: none;
}
.primary-action.data-v-8dea95b8 {
  background: #3a5443;
  color: #f8f4ec;
}
.secondary-action.data-v-8dea95b8 {
  background: #ebe4d6;
  color: #2d4334;
}