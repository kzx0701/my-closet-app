
.filter-card {
  margin-bottom: 24rpx;
  padding: 26rpx 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fbfaf7 100%);
  box-shadow: 0 14rpx 30rpx rgba(73, 81, 69, 0.06);
  border: 2rpx solid rgba(107, 126, 99, 0.08);
}
.filter-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.filter-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #314033;
}
.filter-group + .filter-group {
  margin-top: 20rpx;
}
.group-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 23rpx;
  color: #6f7c6d;
}
.chip-scroll {
  white-space: nowrap;
}
.chip-row {
  display: flex;
  gap: 14rpx;
}
.chip-wrap {
  flex-wrap: wrap;
}
