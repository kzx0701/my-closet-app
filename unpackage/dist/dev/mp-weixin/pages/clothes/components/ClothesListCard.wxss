.clothes-card.data-v-dc245d51 {
  border-radius: 36rpx;
  background: #f8f4ec;
  border: 1px solid rgba(58, 84, 67, 0.1);
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
}
.clothes-card.data-v-dc245d51:hover,
.clothes-card.data-v-dc245d51:active {
  transform: translateY(-3px);
  box-shadow: 0 16rpx 36rpx rgba(73, 81, 69, 0.08);
}
.clothes-card-hover.data-v-dc245d51 {
  transform: translateY(-2px);
  box-shadow: 0 16rpx 36rpx rgba(73, 81, 69, 0.08);
  opacity: 0.92;
}

/* 图片区 */
.clothes-img-wrap.data-v-dc245d51 {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  overflow: hidden;
}
.clothes-img.data-v-dc245d51 {
  width: 100%;
  height: 100%;
  display: block;
}
.clothes-img-placeholder.data-v-dc245d51 {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ebe4d6;
}
.clothes-img-placeholder svg.data-v-dc245d51 {
  width: 56rpx;
  height: 56rpx;
  stroke: #8a8a7e;
  opacity: 0.4;
}

/* 季节标记：左侧4px竖线 */
.season-mark.data-v-dc245d51 {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4px;
}
.season-spring.data-v-dc245d51 {
  background: #7a9580;
}
.season-summer.data-v-dc245d51 {
  background: #5b8fb0;
}
.season-autumn.data-v-dc245d51 {
  background: #b85c3a;
}
.season-winter.data-v-dc245d51 {
  background: #8b7355;
}
.season-all-season.data-v-dc245d51 {
  background: #a8bcae;
}

/* 信息区 */
.clothes-info.data-v-dc245d51 {
  padding: 20rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.clothes-name.data-v-dc245d51 {
  font-family: "Fraunces", "Songti SC", "STSong", "Georgia", "PingFang SC", serif;
  font-size: 30rpx;
  font-weight: 600;
  color: #2a2a24;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.clothes-sub.data-v-dc245d51 {
  font-family: "Manrope", "PingFang SC", "PingFangSC", "Microsoft YaHei", -apple-system, sans-serif;
  font-size: 24rpx;
  color: #8a8a7e;
  line-height: 1.4;
}
.clothes-sub-row.data-v-dc245d51 {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.color-indicator.data-v-dc245d51 {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  border: 1px solid rgba(0, 0, 0, 0.1);
  box-sizing: border-box;
  flex-shrink: 0;
}
.color-indicator-multicolor.data-v-dc245d51 {
  border: 1px solid rgba(0, 0, 0, 0.15);
}