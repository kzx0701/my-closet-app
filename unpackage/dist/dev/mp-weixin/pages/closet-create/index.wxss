.page.data-v-1e56e140 {
  position: relative;
  min-height: 100vh;
  background: linear-gradient(180deg, #2d4334 0%, #3a5443 12%, #4a6755 20%, #7a9580 28%, #a8bcae 34%, #c8cebf 38%, #f4efe6 42%, #f4efe6 100%);
  overflow: hidden;
}

/* 自定义导航栏 */
.navbar.data-v-1e56e140 {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: center;
  padding-left: 28rpx;
  padding-right: 28rpx;
  padding-bottom: 16rpx;
}
.nav-back.data-v-1e56e140 {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-back-icon.data-v-1e56e140 {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #f8f4ec;
}
.nav-back-icon svg.data-v-1e56e140 {
  width: 32rpx;
  height: 32rpx;
}
.nav-title.data-v-1e56e140 {
  flex: 1;
  text-align: center;
  font-family: "Manrope", "PingFang SC", "PingFangSC", "Microsoft YaHei", -apple-system, sans-serif;
  font-size: 30rpx;
  font-weight: 600;
  color: #f8f4ec;
}
.nav-placeholder.data-v-1e56e140 {
  width: 64rpx;
}

/* Hero 区 */
.form-page-hero.data-v-1e56e140 {
  position: relative;
  z-index: 2;
  padding: 24rpx 56rpx 48rpx;
  color: #f8f4ec;
}
.hero-title.data-v-1e56e140 {
  display: block;
  margin-bottom: 20rpx;
  font-family: "Fraunces", "Songti SC", "STSong", "Georgia", "PingFang SC", serif;
  font-size: 52rpx;
  font-weight: 400;
  line-height: 1.15;
  letter-spacing: -0.5px;
  color: #f8f4ec;
}
.hero-desc.data-v-1e56e140 {
  display: block;
  font-family: "Manrope", "PingFang SC", "PingFangSC", "Microsoft YaHei", -apple-system, sans-serif;
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(244, 239, 230, 0.55);
}

/* 表单区 */
.form-body.data-v-1e56e140 {
  position: relative;
  z-index: 2;
  padding: 0 56rpx 240rpx;
}
.section.data-v-1e56e140 {
  margin-top: 48rpx;
}
.form-body .section.data-v-1e56e140:first-child {
  margin-top: 0;
}
.section-title.data-v-1e56e140 {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
  font-family: "JetBrains Mono", "SF Mono", "Consolas", "Menlo", monospace;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #8a8a7e;
}
.form-input.data-v-1e56e140 {
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 40rpx;
  background: rgba(58, 84, 67, 0.04);
  border: 1px solid rgba(58, 84, 67, 0.05);
  font-family: "Manrope", "PingFang SC", "PingFangSC", "Microsoft YaHei", -apple-system, sans-serif;
  font-size: 28rpx;
  color: #2a2a24;
  box-sizing: border-box;
  transition: border-color 0.2s ease;
}
.form-input-focus.data-v-1e56e140 {
  border-color: #3a5443;
}
.form-input-placeholder.data-v-1e56e140 {
  color: #8a8a7e;
  font-size: 26rpx;
}

/* 底部固定栏 */
.form-bottom-bar.data-v-1e56e140 {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 30;
  display: flex;
  gap: 20rpx;
  padding: 32rpx 56rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(244, 239, 230, 0) 0%, #f4efe6 30%);
}
.btn-submit.data-v-1e56e140 {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 40rpx;
  background: #3a5443;
  border: none;
  font-family: "Manrope", "PingFang SC", "PingFangSC", "Microsoft YaHei", -apple-system, sans-serif;
  font-size: 30rpx;
  font-weight: 600;
  color: #f8f4ec;
  transition: all 0.2s ease;
}
.btn-submit-edit.data-v-1e56e140 {
  flex: 2;
}
.btn-submit.data-v-1e56e140:active {
  transform: scale(0.98);
  opacity: 0.9;
}
.btn-submit.data-v-1e56e140::after {
  border: none;
}
.btn-submit[disabled].data-v-1e56e140 {
  opacity: 0.6;
}
.btn-delete.data-v-1e56e140 {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 40rpx;
  background: transparent;
  border: 1px solid rgba(184, 92, 58, 0.3);
  font-family: "Manrope", "PingFang SC", "PingFangSC", "Microsoft YaHei", -apple-system, sans-serif;
  font-size: 30rpx;
  font-weight: 600;
  color: #b85c3a;
  transition: all 0.2s ease;
}
.btn-delete.data-v-1e56e140:hover {
  background: rgba(184, 92, 58, 0.06);
}
.btn-delete.data-v-1e56e140:active {
  transform: scale(0.98);
}
.btn-delete.data-v-1e56e140::after {
  border: none;
}
.btn-delete[disabled].data-v-1e56e140 {
  opacity: 0.6;
}