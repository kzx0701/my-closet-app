.section + .section {
  margin-top: 26rpx;
}
.section-title {
  display: block;
  margin-bottom: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #2a2a24;
}
.color-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.color-chip {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #f3f5ef;
  border: 2rpx solid transparent;
}
.color-chip.active {
  background: #edf1ea;
  border-color: #3a5443;
}
.color-name {
  font-size: 24rpx;
  color: #3a5443;
}