
.form-card {
  padding: 30rpx 26rpx;
  border-radius: 26rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fbfaf7 100%);
  box-shadow: 0 16rpx 36rpx rgba(73, 81, 69, 0.08);
  border: 2rpx solid rgba(107, 126, 99, 0.08);
}
.field + .field {
  margin-top: 24rpx;
}
.label {
  display: block;
  margin-bottom: 14rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #2d392f;
}
.input,
.textarea {
  width: 100%;
  border-radius: 20rpx;
  background: #f2f5ef;
  font-size: 27rpx;
  color: #243026;
  box-sizing: border-box;
}
.input {
  height: 92rpx;
  padding: 0 24rpx;
}
.textarea {
  min-height: 180rpx;
  padding: 22rpx 24rpx;
}
