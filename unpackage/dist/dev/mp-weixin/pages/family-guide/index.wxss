.page.data-v-d7fa870b {
  position: relative;
  min-height: 100vh;
  background: #f4efe6;
  overflow: hidden;
}
.page-bg.data-v-d7fa870b {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
