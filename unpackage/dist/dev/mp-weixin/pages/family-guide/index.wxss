/* 加入家庭弹层 */
.join-mask.data-v-d7fa870b {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.join-sheet.data-v-d7fa870b {
  width: 100%;
  padding: 32rpx 36rpx 72rpx;
  background: #f8f4ec;
  border-radius: 36rpx 36rpx 0 0;
  animation: fadeUp 0.3s cubic-bezier(0.2, 0.8, 0.2, 1) both;
}
.join-header.data-v-d7fa870b {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.join-label.data-v-d7fa870b {
  font-family: "Fraunces", "Songti SC", "STSong", "Georgia", "PingFang SC", serif;
  font-size: 34rpx;
  font-weight: 600;
  color: #2d4334;
}
.join-close.data-v-d7fa870b {
  font-size: 44rpx;
  color: #8a8a7e;
  line-height: 1;
  padding: 0 12rpx;
}
.join-input.data-v-d7fa870b {
  height: 96rpx;
  padding: 0 28rpx;
  border-radius: 40rpx;
  background: #f2f5ef;
  font-family: "JetBrains Mono", "SF Mono", "Consolas", "Menlo", monospace;
  font-size: 32rpx;
  letter-spacing: 4rpx;
  color: #2a2a24;
}
.join-hint.data-v-d7fa870b {
  display: block;
  margin-top: 18rpx;
  font-family: "Manrope", "PingFang SC", "PingFangSC", "Microsoft YaHei", -apple-system, sans-serif;
  font-size: 24rpx;
  line-height: 1.7;
  color: #4a4a42;
}
.join-actions.data-v-d7fa870b {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}
.join-submit.data-v-d7fa870b,
.join-cancel.data-v-d7fa870b {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 40rpx;
  font-family: "Manrope", "PingFang SC", "PingFangSC", "Microsoft YaHei", -apple-system, sans-serif;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}
.join-submit.data-v-d7fa870b {
  background: #3a5443;
  color: #f8f4ec;
}
.join-submit.data-v-d7fa870b::after,
.join-cancel.data-v-d7fa870b::after {
  border: none;
}
.join-cancel.data-v-d7fa870b {
  background: #ebe4d6;
  color: #2d4334;
}