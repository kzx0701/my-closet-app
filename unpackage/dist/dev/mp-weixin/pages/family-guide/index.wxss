.page {
  min-height: 100vh;
  padding: 88rpx 36rpx 80rpx;
  background: linear-gradient(180deg, #f5f3ee 0%, #ffffff 50%, #f2eee6 100%);
}
.card {
  margin-top: 48rpx;
  padding: 40rpx 30rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 40rpx rgba(73, 81, 69, 0.08);
}
.join-card {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid #edf0e8;
}
.join-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #3a5443;
}
.join-input {
  margin-top: 18rpx;
  height: 92rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: #f2f5ef;
  font-size: 30rpx;
  color: #2a2a24;
}
.join-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #4a4a42;
}
.join-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}
.join-submit,
.join-cancel {
  flex: 1;
  border-radius: 999rpx;
}
.join-cancel {
  background: #edf1ea;
  color: #3a5443;
}