}

/* 底部固定栏 */
.bottom-bar.data-v-4dc0e16e {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 30;
  padding: 32rpx 56rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(244, 239, 230, 0) 0%, #f4efe6 30%);
}
.btn-add.data-v-4dc0e16e {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 40rpx;
  background: #3a5443;
  border: none;
  font-family: "Manrope", "PingFang SC", "PingFangSC", "Microsoft YaHei", -apple-system, sans-serif;
  font-size: 30rpx;
  font-weight: 600;
  color: #f8f4ec;
  transition: all 0.2s ease;
}
.btn-add.data-v-4dc0e16e:hover {
  opacity: 0.9;
}
.btn-add.data-v-4dc0e16e:active {
  transform: scale(0.98);
}
.btn-add.data-v-4dc0e16e::after {
  border: none;
}

/* ===== 骨架屏 ===== */
.skeleton.data-v-4dc0e16e {
  background: linear-gradient(90deg, rgba(58, 84, 67, 0.06) 0%, rgba(58, 84, 67, 0.12) 50%, rgba(58, 84, 67, 0.06) 100%);
  background-size: 200% 100%;
  animation: skeletonShimmer 1.4s ease-in-out infinite;
  border-radius: 6px;
}
.skeleton-grid.data-v-4dc0e16e {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}
.skeleton-card.data-v-4dc0e16e {
  border-radius: 36rpx;
  background: #f8f4ec;
  border: 1px solid rgba(58, 84, 67, 0.1);
  overflow: hidden;
}
.skeleton-img.data-v-4dc0e16e {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 0;
}
.skeleton-info.data-v-4dc0e16e {
  padding: 20rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.skeleton-name.data-v-4dc0e16e {
  height: 26rpx;
  width: 60%;
  border-radius: 4rpx;
}
.skeleton-sub.data-v-4dc0e16e {
  height: 20rpx;
  width: 40%;
  border-radius: 4rpx;
}

