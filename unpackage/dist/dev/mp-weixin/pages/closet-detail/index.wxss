/* 衣物网格 */
.clothes-grid.data-v-4dc0e16e {
  position: relative;
  z-index: 2;
  padding: 0 28px 120px;
}
.grid-inner.data-v-4dc0e16e {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}
.grid-item.data-v-4dc0e16e {
  min-width: 0;
}

/* 穿着次数 */
.wear-count.data-v-4dc0e16e {
  margin-top: 10rpx;
