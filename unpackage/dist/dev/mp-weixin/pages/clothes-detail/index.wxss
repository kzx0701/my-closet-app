.page {
  min-height: 100vh;
  padding: 0 0 180rpx;
  background: radial-gradient(circle at top, rgba(214, 223, 205, 0.48), transparent 36%), linear-gradient(180deg, #f4efe6 0%, #f8f4ec 38%, #f3efe6 100%);
}
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
}
.loading-text {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #4a4a42;
}
.image-section {
  width: 100%;
  height: 500rpx;
}
.cover-image {
  width: 100%;
  height: 100%;
}
.info-card {
  margin: 24rpx 28rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f8f4ec 100%);
  box-shadow: 0 16rpx 36rpx rgba(73, 81, 69, 0.08);
  border: 2rpx solid rgba(107, 126, 99, 0.08);
}
.badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.title {
  display: block;
  margin-top: 24rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #2a2a24;
}
.meta-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 30rpx;
}
.meta-item {
  padding: 16rpx;
  border-radius: 20rpx;
  background: #ebe4d6;
}
.meta-label {
  display: block;
  font-size: 20rpx;
  color: #4a4a42;
}
.meta-value {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #3a5443;
}
.remark-section {
  margin-top: 30rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(107, 126, 99, 0.08);
}
.remark-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #3a5443;
}
.remark-text {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #4a4a42;
}
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 16rpx;
  padding: 24rpx 28rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}
.empty-state {
  padding: 200rpx 0;
}