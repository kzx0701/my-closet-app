{
  "bsonType": "object",
  "required": [
    "family_id",
    "user_id",
    "role",
    "status"
  ],
  "permission": {
    "read": "auth.uid != null",
    "create": "auth.uid != null",
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "家庭成员关系ID，系统自动生成"
    },
    "family_id": {
      "bsonType": "string",
      "title": "家庭ID",
      "foreignKey": "families._id"
    },
    "user_id": {
      "bsonType": "string",
      "title": "用户ID",
      "foreignKey": "uni-id-users._id"
    },
    "role": {
      "bsonType": "string",
      "title": "角色",
      "defaultValue": "member",
      "enum": [
        {
          "text": "管理员",
          "value": "admin"
        },
        {
          "text": "普通成员",
          "value": "member"
        }
      ]
    },
    "status": {
      "bsonType": "string",
      "title": "状态",
      "defaultValue": "active",
      "enum": [
        {
          "text": "正常",
          "value": "active"
        },
        {
          "text": "停用",
          "value": "disabled"
        }
      ]
    },
    "joined_at": {
      "bsonType": "timestamp",
      "title": "加入时间",
      "forceDefaultValue": {
        "$env": "now"
      }
    },
    "created_at": {
      "bsonType": "timestamp",
      "title": "创建时间",
      "forceDefaultValue": {
        "$env": "now"
      }
    },
    "updated_at": {
      "bsonType": "timestamp",
      "title": "更新时间",
      "forceDefaultValue": {
        "$env": "now"
      }
    }
  }
}
